{
  "name": "atlas-veterinario-3d",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contracts": "vitest run tests/contracts",
    "validate:data": "tsx scripts/validate-anatomy.ts",
    "test:smoke": "tsx scripts/smoke-api.ts",
    "docs:api": "tsx scripts/generate-openapi.ts",
    "test:smoke:local": "tsx scripts/smoke-local.ts",
    "test:smoke:production": "tsx scripts/smoke-local.ts --production",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop",
    "validate:media": "tsx scripts/validate-media.ts",
    "validate:viewer": "tsx scripts/validate-viewer-assets.ts",
    "anatomy:index": "tsx scripts/anatomy/build-search-index.ts",
    "anatomy:inspect": "tsx scripts/anatomy/inspect-assets.ts",
    "anatomy:convert": "tsx scripts/anatomy/convert-assets.ts",
    "anatomy:reconcile": "tsx scripts/anatomy/reconcile-structures.ts",
    "anatomy:validate": "tsx scripts/anatomy/validate-assets.ts",
    "osteology:inventory": "tsx scripts/osteology/generate-reference-inventories.ts",
    "osteology:validate": "tsx scripts/osteology/validate-inventories.ts",
    "osteology:coverage": "tsx scripts/osteology/validate-inventories.ts --report"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "lucide-react": "1.53.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "happy-dom": "20.14.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "type": "module"
}
